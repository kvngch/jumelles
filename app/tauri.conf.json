{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jumelles",
  "identifier": "fr.kvngch.jumelles",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Jumelles",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
